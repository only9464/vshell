# ============================================================================
# VShell .gitignore
# ============================================================================

# --- Built binaries ---
*.exe
*.dll
*.so
*.elf
*.bin
vshell
vshell-linux-amd64
vshell-windows-amd64.exe

# --- Agent build output ---
agents/
!agents/.gitkeep

# --- Database ---
*.db
*.db-shm
*.db-wal
db/

# --- Config (contains passwords/keys) ---
conf/
!conf/.gitkeep
!conf/setting.conf
!conf/server.pem

# --- Certs & Keys ---
certs/
*.pem
*.key
*.crt
!conf/server.pem

# --- Uploads & downloads ---
uploads/
downloads/

# --- Logs ---
*.log
logs/

# --- Screenshots & Playwright artifacts ---
.playwright-mcp/

# --- IDE ---
.vscode/
.idea/
*.swp
*.swo
*~

# --- OS ---
.DS_Store
Thumbs.db
Desktop.ini

# --- Go ---
*.test
*.out
vendor/

# --- Temp ---
tmp/
temp/
*.tmp

# --- Python ---
__pycache__/
*.pyc

# --- Agent / AI artifacts ---
.omo/
.codegraph

# --- Screenshots ---
*.png
*.jpg
*.jpeg
*.webp

# --- Third-party tools ---
# 插件二进制不入库，但保留示例源码与说明
plugins/*
!plugins/README.md
!plugins/sysinfo/
!plugins/sysinfo/**

# --- Test artifacts ---
test_edit.txt
test_wget.html
qa_test_dir/
test_setting.conf

# --- Reverse-engineering tooling ---
# 注意：scripts/ 曾整体被忽略，导致 e2e 回归脚本与 RE 工具链从未入库（R21 修正）。
# 只保留真正的大体积/私有产物在忽略列表里，工具脚本本身要跟仓库走。
scripts/extract-out/
scripts/**/*.bin

# --- Original binary & license (private / large) ---
v_windows_amd64/
license.txt

# --- Extracted agent binaries (large, regenerable from server) ---
agent_*
!agent/

# --- RE working notes (private) ---
.re/

# --- Large RE memory dumps (regenerable) ---
.re/mem_strings_*.txt
.re/*.bin
.re/full_*.bin
.re/heap*.bin
.re/sw_*.bin
.re/k*.bin
.re/w*.bin
.re/h*.bin
.re/dns_*.bin
.re/pt*.bin
.re/around.bin
.re/first37.bin
.re/watch1.bin
.re/wbuf.bin

# --- Extracted agent templates (large, regenerate with scripts/extract-templates.py) ---
template-extract/

# --- Agent build artifact ---
agent/agent

# --- Vue3 前端 ---
web/node_modules/
web/dist/
