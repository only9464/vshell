    "ConnType": "\"v\"",
    "Host": "\"v\"",
    "LocalProxy": false,
    "RemoteAddr": "\"v\"",
    "Req": {
      "Pass": "\"v\"",
      "Type": "<类型码>",
      "File": "base64|null",
      "Z1..Z5": "参数位"
    },
    "Option": {
      "Timeout": "纳秒（默认 5e9）"
    }
  },
  "type_codes": {
    "M": "执行命令(Z1=命令)",
    "B": "列目录(Z1=目录)",
    "C": "读文件(Z1=完整路径)",
    "A": "磁盘信息",
    "D": "touch(Z1=路径)",
    "J": "mkdir(Z1=目录，末尾/)",
    "I": "move(Z1=Z2=\"src|<-dst/\")",
    "DSELF": "删除文件",
    "Upload": "上传(File=base64内容, Z1=目标路径)"
  },
  "result_record": "C→S payload 形如 `->|<输出>|<-`",
